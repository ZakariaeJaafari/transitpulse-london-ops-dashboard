# Copy to .env and fill locally (.env is gitignored). Never commit real values.

TFL_APP_KEY=
MOTHERDUCK_TOKEN=

# MinIO (local lake). Used by docker compose and lake/upload_bronze.py
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# Host / laptop commands (upload_bronze, uv run ingest on Windows). Airflow in Compose overrides to http://minio:9000.
MINIO_ENDPOINT=http://localhost:9000

# Airflow UI (Compose only). Defaults: admin / admin
AIRFLOW_WWW_USER=admin
AIRFLOW_WWW_USER_PASSWORD=admin
