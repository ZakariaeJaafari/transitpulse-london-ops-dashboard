FROM apache/airflow:2.10.4-python3.12

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

USER airflow
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/home/airflow/.local/bin:${PATH}"

WORKDIR /opt/transitpulse/zoomcamp

COPY docker/airflow-entrypoint.sh /entrypoint-transitpulse.sh
USER root
RUN chmod +x /entrypoint-transitpulse.sh
USER airflow

ENTRYPOINT ["/entrypoint-transitpulse.sh"]
